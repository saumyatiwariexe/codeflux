{
  "name": "@campus-pulse/api",
  "version": "1.0.0",
  "description": "Paladeium — Fastify API Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "node -e \"require('./src/plugins/supabase').runMigrations()\"",
    "db:seed": "ts-node src/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@google/genai": "^2.22.0",
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^5.12.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.0",
    "firebase-admin": "^12.5.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.15",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.16",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}

# Environment Variables — Campus Pulse API
# Copy this to .env and fill in your values

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Supabase (PostgreSQL) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ---- Firebase Auth ----
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ---- Redis (Upstash) ----
REDIS_URL=redis://default:password@your-redis.upstash.io:6379
REDIS_TOKEN=your-upstash-rest-token

# ---- AI ----
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-for-embeddings

# ---- Storage ----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET_NAME=campus-pulse-uploads
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ---- Email (Nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=campuspulse@gmail.com
SMTP_PASS=your-app-password

# ---- App ----
JWT_SECRET=super-secret-jwt-signing-key-change-in-production
FRONTEND_URL=http://localhost:8081

# Environment Variables — Paladeium API
# Copy this to .env and fill in your values

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Supabase (PostgreSQL) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ---- Clerk Auth (replaces Firebase — see AMD-008) ----
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key-here
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key-here

# ---- Redis (Upstash) ----
REDIS_URL=redis://default:password@your-redis.upstash.io:6379
REDIS_TOKEN=your-upstash-rest-token

# ---- AI ----
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-for-embeddings

# ---- Storage ----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET_NAME=paladeium-uploads
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ---- Email (Nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=paladeium@gmail.com
SMTP_PASS=your-app-password

# ---- App ----
JWT_SECRET=super-secret-jwt-signing-key-change-in-production
FRONTEND_URL=http://localhost:8081

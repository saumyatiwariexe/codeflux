# Paladeium Mobile — Environment Variables
# Copy this file to .env.local for local dev; never commit real keys.

# ── Clerk Auth (AMD-008) ──────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com -> Your App -> API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_CLERK_KEY

# ── Supabase (AMD-008) ────────────────────────────────────────────────────────
# Get from: https://supabase.com -> Your Project -> Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_ANON_KEY

# ── Mapbox (existing) ─────────────────────────────────────────────────────────
# Token also lives in android/app/src/main/res/values/strings.xml
EXPO_PUBLIC_MAPBOX_TOKEN=REPLACE_WITH_YOUR_MAPBOX_TOKEN

# Paladeium Mobile — Environment Variables Example
# Copy to .env and fill in your keys

# ---- Mapbox ----
EXPO_PUBLIC_MAPBOX_KEY=pk.your-mapbox-public-key
MAPBOX_DOWNLOAD_TOKEN=sk.your-mapbox-secret-download-token

# ---- Clerk Auth ----
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# ---- Supabase ----
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- API Backend ----
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
